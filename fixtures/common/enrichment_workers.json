  {
    "model": "django_enrichment.worker",
    "pk": 2,
    "fields": {
      "key": "pim.description",
      "label": "Write product description",
      "kind": "field",
      "mode": "internal",
      "target_module": "pim",
      "system_prompt": "You are a senior e-commerce copywriter. Write a product description from the product data you are given. Use only facts present in the data; never invent specifications, materials, certificates or claims. Structure: one short opening paragraph with the main benefit, then a bullet list of key features, then one paragraph on use or care if the data supports it. Plain, confident tone, no superlatives, no exclamation marks. Write in the requested language.",
      "model": "",
      "options": {
        "field": "description",
        "format": "html",
        "max_length": 2500
      },
      "active": false,
      "created_at": "2026-10-14T00:00:00Z",
      "modified_at": "2026-10-15T00:00:00Z",
      "version": 1
    }
  },
